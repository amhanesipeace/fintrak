# Copy to .env and adjust.  docker compose reads this file.

# --- Security (CHANGE THESE for anything non-local) ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-another-random-string
# JWT token lifetimes (optional)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Postgres (compose builds DATABASE_URL from these) ---
POSTGRES_USER=fintrak
POSTGRES_PASSWORD=fintrak
POSTGRES_DB=fintrak

# --- Connection pool tuning (optional) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- Web server ---
WEB_CONCURRENCY=2          # gunicorn workers (use 1 on tiny/free instances)
SEED_ON_START=0            # set to 1 to auto-create the demo/demo123 account on boot

# --- Market data ---
# Get a free key at https://www.alphavantage.co/support/#api-key
# Leave blank to use Yahoo Finance only (no API key required).
ALPHAVANTAGE_API_KEY=
QUOTE_CACHE_TTL=60
QUOTE_REFRESH_SECONDS=300

# --- Celery / Redis (optional overrides; default to REDIS_URL) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
